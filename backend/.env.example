# =====================================================================
# Backend environment variables — copy to `.env` and fill in real values
#   cp .env.example .env
# docker-compose reads this file automatically. Do NOT commit `.env`.
# =====================================================================

# ----- Database (Postgres) -----
# Consumed by docker-compose for both the `db` and `app` services.
DB_USERNAME=crm_user
DB_PASSWORD=change_me_strong_password

# ----- JWT -----
# MUST be a Base64 string that decodes to at least 32 bytes (256 bits) for HS256.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=replace_with_base64_secret_at_least_32_bytes

# ----- Firebase (push notifications) -----
# Optional. If left blank / credentials file is absent, push notifications
# are disabled and the app still boots normally.
FIREBASE_PROJECT_ID=

# ----- Public URLs -----
# Used to build the invite link in the email. Must be an address the phone can
# reach, not localhost.
APP_BASE_URL=http://localhost:8080
# Optional override for where the invite button points. Defaults to
# ${APP_BASE_URL}/api/invite, the landing page this backend serves. Repoint it
# at a deep link once App Links / Universal Links are published.
INVITE_URL=

# ----- Admin -----
# The one account that may delete users and can never itself be deleted.
PRIMARY_ADMIN_EMAIL=admin@gmail.com

# ----- Email / SMTP (invite emails) -----
# Optional. Emails are only sent when MAIL_ENABLED=true AND creds are set;
# otherwise invites still work (the admin gets the code in-app).
# For Gmail: MAIL_USERNAME = your address, MAIL_PASSWORD = a 16-char App Password
# (Google account → Security → 2-Step Verification → App passwords).
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Rejects invites to domains with no MX/A record, which catches typos like
# gmial.com. Turn off for offline development, where every lookup fails.
MAIL_VERIFY_DOMAIN=true

# ----- pgAdmin (only used by the `dev` compose profile) -----
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me
