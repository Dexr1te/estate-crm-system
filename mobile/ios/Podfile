# Uncomment this line to define a global platform for your project
# platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

# file_picker compiles three pickers; the app uses one.
#
# `FileGateway.pickFile` only ever calls `FilePicker.pickFiles()` — FileType.any,
# which iOS serves with UIDocumentPickerViewController (the PICKER_DOCUMENT path,
# left on). The media and audio pickers are dead weight, and expensive dead
# weight: PICKER_MEDIA pulls in DKImagePickerController/DKPhotoGallery and puts
# PHPhotoLibrary, PHAssetCreationRequest, PHPickerViewController and
# UIImagePickerController in the binary, while PICKER_AUDIO adds
# MPMediaPickerController.
#
# App Store Connect scans the binary for exactly those symbols and rejects the
# upload with ITMS-90683 unless Info.plist carries NSPhotoLibraryUsageDescription,
# NSPhotoLibraryAddUsageDescription, NSCameraUsageDescription and
# NSAppleMusicUsageDescription. Declaring four permissions the app never asks for
# — and answering for them in the privacy questionnaire — to ship code it never
# reaches is the wrong trade. Compiling them out is the honest fix: it drops four
# embedded frameworks (~4.4 MB) with them.
#
# Turning either back on means restoring the matching purpose strings in
# ios/Runner/Info.plist first.
#
# Set on `Pod` rather than written as a bare `PICKER_MEDIA = false`: CocoaPods
# instance_evals this file, so a plain assignment lands on the Podfile's
# singleton class where the podspec's `Pod.const_defined?` check cannot see it,
# and the flags silently do nothing.
%w[PICKER_MEDIA PICKER_AUDIO].each do |flag|
  Pod.const_set(flag, false) unless Pod.const_defined?(flag)
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end
