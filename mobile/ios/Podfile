# Uncomment this line to define a global platform for your project
# platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

# file_picker compiles three pickers; the app uses two.
#
# PICKER_DOCUMENT serves `FileGateway.pickFile` — a deal's paperwork, through
# UIDocumentPickerViewController. PICKER_MEDIA serves `pickImages`, and it is on
# because a listing's photographs live in the photo library and nowhere else:
# picking them through the document browser would mean asking an agent to export
# their own camera roll into Files first.
#
# It is not free. PICKER_MEDIA pulls in DKImagePickerController/DKPhotoGallery
# and puts PHPhotoLibrary, PHAssetCreationRequest, PHPickerViewController and
# UIImagePickerController in the binary, which App Store Connect scans for: the
# upload is rejected with ITMS-90683 unless Info.plist carries
# NSPhotoLibraryUsageDescription, NSPhotoLibraryAddUsageDescription and
# NSCameraUsageDescription. Those three are declared, and the privacy
# questionnaire has to answer for them.
#
# PICKER_AUDIO stays off. Nothing in the app picks a song, and leaving it on
# would add MPMediaPickerController and a fourth permission
# (NSAppleMusicUsageDescription) for code nothing reaches.
#
# Set on `Pod` rather than written as a bare `PICKER_AUDIO = false`: CocoaPods
# instance_evals this file, so a plain assignment lands on the Podfile's
# singleton class where the podspec's `Pod.const_defined?` check cannot see it,
# and the flag silently does nothing.
Pod.const_set('PICKER_AUDIO', false) unless Pod.const_defined?('PICKER_AUDIO')

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end
